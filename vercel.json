{
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/book/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ff]acebook|[Ww]hats[Aa]pp|[Tt]elegram|[Dd]iscord|[Ll]inked[Ii]n|[Tt]witter).*"
        }
      ],
      "destination": "/api/book?slug=:slug"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}